---
// MeterReadings.astro — Sheet B-01 summary on the home sheet. Every number is
// derived at build time from data/stats.json (same helpers as Telemetry.astro).
import SheetHead from './SheetHead.astro';
import statsJson from '../../data/stats.json';
import type { StatsJson, HeatBucket } from '../lib/telemetry.types';
import { formatCompact, formatDateRange, peakDayInRange, TELEMETRY_START_ISO, heatBucketColor } from '../lib/telemetry';

const stats = statsJson as unknown as StatsJson;
const { meta, totals } = stats;
const dailySessions = Object.fromEntries(stats.daily_sessions);

const files = formatCompact(meta.files_found);
const range = formatDateRange(meta.date_min, meta.date_max);
const peak = peakDayInRange(dailySessions, TELEMETRY_START_ISO, meta.date_max);
const buckets: HeatBucket[] = ['quiet', 'low', 'mid', 'high', 'peak'];

const cells = [
	{ value: formatCompact(totals.lines_added), label: 'lines added, every repo' },
	{ value: formatCompact(totals.sessions), label: `sessions · ${formatCompact(totals.user_msgs)} prompts` },
	{ value: formatCompact(totals.out_tokens), label: 'tokens written' },
	{ value: formatCompact(totals.cache_read_tokens), label: 'tokens read from cache' },
];
---

<section id="meters" data-screen-label="Meter readings" class="fy-meters">
	<SheetHead code="B-01" kicker="Sheet B-01" headingLevel={2} title="Meter readings" lead={`Everything above is built with Claude Code. Parsed locally from ${files} session logs, ${range}.`} />
	<div class="fy-meters__grid">
		{cells.map((c) => (
			<div class="fy-meters__cell">
				<div class="fy-meter-num">{c.value}</div>
				<div class="fy-meters__label">{c.label}</div>
			</div>
		))}
	</div>
	<div class="fy-meters__ramp">
		<div class="fy-meters__swatches" aria-hidden="true">
			{buckets.map((b) => <span style={`background:${heatBucketColor(b)}`} />)}
		</div>
		<span>Heatmaps ramp by graphite density; redline marks the peak{peak ? ` — ${peak.label}, ${formatCompact(peak.value)} sessions in one day` : ''}.</span>
		<a href={`${import.meta.env.BASE_URL}telemetry/`}>Full telemetry sheet →</a>
	</div>
</section>

<style>
	.fy-meters { max-width: 1360px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 40px); box-sizing: border-box; scroll-margin-top: 58px; }
	.fy-meters__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); font-variant-numeric: tabular-nums; }
	.fy-meters__cell { padding: 24px; border-right: 1px solid var(--ds-line); }
	.fy-meters__cell:first-child { padding-left: 0; }
	.fy-meters__cell:last-child { padding-right: 0; border-right: 0; }
	.fy-meters__label { color: var(--ds-text-2); font-size: 15px; }
	.fy-meters__ramp { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; padding-top: 18px; border-top: 1px solid var(--ds-line); font-size: 14.5px; color: var(--ds-text-2); }
	.fy-meters__swatches { display: flex; gap: 3px; }
	.fy-meters__swatches span { display: block; width: 18px; height: 18px; border: 1px solid var(--ds-line); }
	.fy-meters__ramp a { margin-left: auto; }
	@media (max-width: 700px) {
		.fy-meters__cell { border-right: 0; border-bottom: 1px solid var(--ds-line); padding-left: 0; padding-right: 0; }
		.fy-meters__cell:last-child { border-bottom: 0; }
		.fy-meters__ramp a { margin-left: 0; }
	}
</style>
