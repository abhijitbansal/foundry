---
// Telemetry.astro — body of the /telemetry/ page (Sheet B-01): headline
// meter readings, the yard ledger, the since-May-1 heatmap, top tools, model
// mix, chips and the memekit terminal. Every number is derived at build time
// from data/stats.json via src/lib/telemetry.ts; heatmap cells live in
// Heatmap.astro. The activity card runs from TELEMETRY_START_ISO (May 1, 2026)
// through the latest data day, not a trailing 30-day window.
import Heatmap from './Heatmap.astro';
import SheetHead from './SheetHead.astro';
import statsJson from '../../data/stats.json';
import type { StatsJson } from '../lib/telemetry.types';
import {
	formatCompact,
	TELEMETRY_START_ISO,
	dateRangeCells,
	rangeSum,
	peakDayInRange,
	modelMixSegments,
	topToolBars,
	memekitTerminal,
	lookupCount,
	formatDateRange,
	daysBetweenInclusive,
	heatmapAriaLabel,
	heatBucketColor,
} from '../lib/telemetry';
import type { HeatBucket } from '../lib/telemetry.types';
import { buildLedger } from '../lib/works';
import { loadWorksRepos } from '../lib/yard-data';

const stats = statsJson as unknown as StatsJson;

// Legend swatches, quiet -> peak — reads straight off heatBucketColor()
// instead of hand-duplicating the ramp's color-mix expressions a
// second time in markup; this legend used to hardcode its own copy of the
// same 5 literal color-mix strings, which would have silently gone stale
// against the actual cells the moment the ramp changed underneath it.
const HEAT_LEGEND_BUCKETS: HeatBucket[] = ['quiet', 'low', 'mid', 'high', 'peak'];
const { meta, totals } = stats;

// Yard ledger rows — shared with the home schedule via lib/yard-data.
const worksRepos = loadWorksRepos();

const worksLedger = buildLedger(worksRepos);
const worksTallest = worksLedger[0];
const worksVacant = worksLedger.filter((e) => e.storeys === 0);
const worksCaption = worksTallest
	? `${worksTallest.repo} — tallest hall on the yard, ${formatCompact(worksTallest.lines)} lines and counting.` +
		(worksVacant.length > 0 ? ` ${worksVacant.map((v) => v.repo).join(', ')} — site cleared, groundbreaking soon.` : '')
	: '';

const dailyOutTokens = Object.fromEntries(stats.daily_out_tokens);
const dailySessions = Object.fromEntries(stats.daily_sessions);
const dailyLines = Object.fromEntries(stats.daily_lines);

const filesFound = formatCompact(meta.files_found);
const dateRange = formatDateRange(meta.date_min, meta.date_max);
const daysSpan = daysBetweenInclusive(meta.date_min, meta.date_max);

const heatmapCells = dateRangeCells(dailyOutTokens, TELEMETRY_START_ISO, meta.date_max);
const windowStartLabel = heatmapCells[0].label;
const windowEndLabel = heatmapCells[heatmapCells.length - 1].label;
const heatmapLabel = heatmapAriaLabel(heatmapCells);

const windowSessions = rangeSum(dailySessions, TELEMETRY_START_ISO, meta.date_max);
const windowLines = rangeSum(dailyLines, TELEMETRY_START_ISO, meta.date_max);
const windowTokensOut = rangeSum(dailyOutTokens, TELEMETRY_START_ISO, meta.date_max);
const peakSessionsDay = peakDayInRange(dailySessions, TELEMETRY_START_ISO, meta.date_max);

const modelSegments = modelMixSegments(stats.models, totals.assistant_msgs);
const toolBars = topToolBars(stats.top_tools, 5);

const thinkingBlocks = formatCompact(totals.thinking_blocks);
const subagentRuns = formatCompact(lookupCount(stats.top_tools, 'Agent'));
const skillInvocations = formatCompact(lookupCount(stats.top_tools, 'Skill'));
const compactCount = lookupCount(stats.top_slash, '/compact');
const longestPrompt = formatCompact(stats.global_prompts.max);
const cubbyScreenshots = stats.repos.find((r) => r.repo === 'cubby')?.image_count ?? 0;

const statCells = [
	{ value: formatCompact(totals.lines_added), label: 'lines added', note: `across every repo, ${daysSpan} days` },
	{ value: formatCompact(totals.sessions), label: 'sessions', note: `${formatCompact(totals.user_msgs)} prompts · ${formatCompact(totals.assistant_msgs)} replies` },
	{ value: formatCompact(totals.out_tokens), label: 'tokens written', note: 'model output' },
	{ value: formatCompact(totals.cache_read_tokens), label: 'tokens read from cache', note: 'context served from the prompt cache' },
];

const memekitLines = memekitTerminal(totals.in_tokens, totals.out_tokens, totals.cache_read_tokens);
---

<section id="telemetry" data-screen-label="Telemetry" style="position:relative">
	<div style="max-width:1360px;margin:0 auto;padding:0 clamp(16px,3vw,40px) clamp(64px,9vw,110px);box-sizing:border-box">
		<div data-reveal>
			<SheetHead code="B-01" title="Meter readings, in full." lead={`Everything on this site is built with Claude Code. Parsed locally from ${filesFound} session logs, ${dateRange}.`} />
		</div>

		<div id="telemetry-body" tabindex="-1" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:clamp(16px,2vw,26px);margin-top:clamp(26px,4vw,42px)">
			{
				statCells.map((c) => (
					<div data-reveal style="border-top:1px solid var(--ds-line);padding-top:18px;display:flex;flex-direction:column;gap:7px">
						<span class="fy-tele-num">{c.value}</span>
						<span class="ds-micro" style="color:var(--ds-text);font-weight:500">{c.label}</span>
						<span class="ds-caption">{c.note}</span>
					</div>
				))
			}
		</div>

		<div data-reveal style="margin-top:clamp(36px,5vw,56px);display:flex;flex-direction:column;gap:16px">
			<h2 class="ds-display-md" style="margin:0">Yard ledger</h2>
			<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:14px">
				{worksLedger.map((entry) => (
					<div style="border-top:1px solid var(--ds-line);padding-top:10px;display:flex;flex-direction:column;gap:4px">
						<span style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
							<span class="ds-micro" style="color:var(--ds-text-3)">{String(entry.rank).padStart(2, '0')}</span>
							<span class="ds-micro" style="color:var(--ds-text);font-weight:600">{entry.repo}</span>
							<span class="ds-caption" style="color:var(--ds-text-2)">{entry.storeys} {entry.storeys === 1 ? 'storey' : 'storeys'}</span>
						</span>
						<span class="ds-caption" style="color:var(--ds-text-2)">
							{formatCompact(entry.sessions)} sessions · {formatCompact(entry.lines)} lines · {formatCompact(entry.tokens)} tok out
						</span>
					</div>
				))}
			</div>
			<p class="ds-caption" style="margin:0;color:var(--ds-text-2);max-width:72ch;text-wrap:pretty">{worksCaption}</p>
			<p class="ds-caption" style="margin:0;color:var(--ds-text-3)">Per-repo figures are floors; old transcripts rotate out.</p>
		</div>

		<div class="fy-tele-grid" style="display:grid;gap:20px;margin-top:clamp(26px,4vw,40px);align-items:stretch">
			<article class="fy-well fy-tele-heat" data-reveal style="display:flex;flex-direction:column;gap:18px;padding:24px 26px">
				<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap">
					<h2 class="ds-micro" style="color:var(--ds-text);font-weight:500;margin:0">Since May 1</h2>
					<span class="ds-micro" style="color:var(--ds-text-2)">{windowStartLabel} – {windowEndLabel} · out-tokens per day</span>
				</div>
				<div style="display:flex;gap:clamp(18px,3vw,32px);align-items:flex-start;flex-wrap:wrap">
					{/* the since-May-1 grid grows a 16px column every 7 days — scroll it
					    inside the card instead of letting it overflow on small screens */}
					<div style="max-width:100%;overflow-x:auto;padding-bottom:4px">
						<Heatmap cells={heatmapCells} ariaLabel={heatmapLabel} />
					</div>
					<div style="display:flex;flex-direction:column;gap:14px;flex:1;min-width:150px">
						<div style="display:flex;flex-direction:column;gap:3px">
							<span class="fy-tele-num fy-tele-num--sm">{formatCompact(windowSessions)}</span>
							<span class="ds-micro" style="color:var(--ds-text-2)">Sessions</span>
						</div>
						<div style="display:flex;flex-direction:column;gap:3px">
							<span class="fy-tele-num fy-tele-num--sm">{formatCompact(windowLines)}</span>
							<span class="ds-micro" style="color:var(--ds-text-2)">Lines added</span>
						</div>
						<div style="display:flex;flex-direction:column;gap:3px">
							<span class="fy-tele-num fy-tele-num--sm">{formatCompact(windowTokensOut)}</span>
							<span class="ds-micro" style="color:var(--ds-text-2)">Tokens out</span>
						</div>
					</div>
				</div>
				<div style="margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-top:1px solid var(--ds-line);padding-top:14px">
					<span class="ds-caption" style="color:var(--ds-text-2)">
						{peakSessionsDay && (
							<>
								Peak: {peakSessionsDay.label} — {formatCompact(peakSessionsDay.value)} sessions in one day
							</>
						)}
					</span>
					<span style="display:inline-flex;align-items:center;gap:4px">
						<span class="ds-micro" style="color:var(--ds-text-2);margin-right:4px">cool</span>
						{
							HEAT_LEGEND_BUCKETS.map((bucket) => (
								<span
									style={`width:12px;height:12px;border-radius:0;background:${heatBucketColor(bucket)}${bucket === 'quiet' ? ';border:1px solid var(--ds-line);box-sizing:border-box' : ''}`}
								/>
							))
						}
						<span class="ds-micro" style="color:var(--ds-text-2);margin-left:4px">hot</span>
					</span>
				</div>
			</article>

			<article class="fy-well fy-tele-tools" data-reveal style="display:flex;flex-direction:column;gap:14px;padding:24px 26px">
				<h2 class="ds-micro" style="color:var(--ds-text);font-weight:500;margin:0">Top tools</h2>
				{toolBars.map((bar) => (
					<div style="display:flex;flex-direction:column;gap:5px">
						<div style="display:flex;justify-content:space-between;gap:12px">
							<span class="ds-micro" style="color:var(--ds-text-2)">{bar.label}</span>
							<span class="ds-micro" style="color:var(--ds-text-2)">{formatCompact(bar.count)}</span>
						</div>
						<div aria-hidden="true" style="height:3px;background:var(--ds-line);border-radius:0">
							<div style={`width:${bar.percent}%;height:3px;background:var(--ds-text);border-radius:0`}></div>
						</div>
					</div>
				))}
			</article>

			<article class="fy-well fy-tele-mix" data-reveal style="display:flex;flex-direction:column;gap:16px;padding:24px 26px">
				<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap">
					<h2 class="ds-micro" style="color:var(--ds-text);font-weight:500;margin:0">Model mix</h2>
					<span class="ds-micro" style="color:var(--ds-text-2)">{formatCompact(totals.assistant_msgs)} assistant messages</span>
				</div>
				<div aria-hidden="true" style="display:flex;height:8px;border-radius:0;overflow:hidden">
					{modelSegments.map((seg) => <span style={`width:${seg.percent}%;background:${seg.colorVar}`} />)}
				</div>
				<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:9px 18px">
					{modelSegments.map((seg) => (
						<span style="display:inline-flex;align-items:center;gap:8px">
							<span style={`width:7px;height:7px;border-radius:0;background:${seg.colorVar};flex:none`}></span>
							<span class="ds-micro" style="color:var(--ds-text-2)">
								{seg.label} · {seg.percent}%
							</span>
						</span>
					))}
				</div>
			</article>
		</div>

		<div data-reveal style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px">
			<span class="ds-chip">{thinkingBlocks} thinking blocks</span>
			<span class="ds-chip">{subagentRuns} subagent runs</span>
			<span class="ds-chip">{skillInvocations} skill invocations</span>
			<span class="ds-chip">/compact × {compactCount}</span>
			<span class="ds-chip">longest prompt: {longestPrompt} chars</span>
			<span class="ds-chip">{cubbyScreenshots} screenshots into cubby</span>
		</div>

		<aside data-reveal style="margin-top:22px;background:var(--ds-surface-2);border:1px solid var(--ds-line);border-radius:var(--ds-radius-lg);overflow:hidden;max-width:760px">
			<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 20px;border-bottom:1px solid var(--ds-line)">
				<span class="ds-micro" style="color:var(--ds-text-3)">$ memekit react --to "the token ledger"</span>
				<span class="ds-micro" style="color:var(--ds-text-2)">80×24</span>
			</div>
			<pre style="margin:0;padding:20px 24px;font-family:var(--ds-font-mono);font-size:12.5px;line-height:1.65;color:var(--ds-text-2);overflow-x:auto">{memekitLines[0]}
{memekitLines[1]}
{memekitLines[2]}

(ノ°□°)ノ ︵ ┻━┻      the ledger, first read
┬─┬ ノ( ゜-゜ノ)      the ledger, accepted

<span style="color:var(--ds-secondary)">0 regrets · {formatCompact(totals.lines_added)} lines shipped</span></pre>
		</aside>

		<p class="ds-caption" data-reveal style="margin:18px 0 0;max-width:72ch;text-wrap:pretty">
			Counted from {filesFound} local session logs by a{' '}
			<a
				href="https://github.com/abhijitbansal/claude-skills"
				target="_blank"
				rel="noopener"
				class="fy-link-underline"
				style="color:var(--ds-text)"
				>claude-skills</a
			>{' '}script — on-device, like everything else here. Regenerated at each deploy.
		</p>
	</div>
</section>

<style>
	.fy-tele-num {
		font: 500 clamp(34px, 3.4vw, 46px) var(--ds-font-mono);
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
	}
	.fy-tele-num--sm {
		font-size: 26px;
		line-height: 1.1;
	}
</style>
