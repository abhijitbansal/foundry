---
// HarnessPromo.astro — a plain bordered row linking to Sheet C-01 (/harness/).
// Deliberately not a card: one ruled line between the meters and the footer.
---

<div class="fy-promo-wrap">
	<a href={`${import.meta.env.BASE_URL}harness/`} class="fy-promo">
		<span class="ds-kicker">Sheet C-01</span>
		<span>How this site gets built — hooks, routing, and an honest audit of the harness behind it.</span>
		<span aria-hidden="true">→</span>
	</a>
</div>

<style>
	.fy-promo-wrap { max-width: 1360px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 3vw, 40px) clamp(40px, 5vw, 64px); box-sizing: border-box; }
	.fy-promo { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; padding: 18px 0; border-top: 1px solid var(--ds-text); border-bottom: 1px solid var(--ds-text); text-decoration: none; }
	.fy-promo:hover span:nth-child(2) { text-decoration: underline; text-decoration-thickness: 2.5px; }
</style>
