---
// CraftFooterCTA.astro — closing invitation, mirrors HarnessFooterCTA's
// register: argue-with-me mailto plus the harness cross-link.
const base = import.meta.env.BASE_URL;
---

<section data-screen-label="Footer CTA" style="max-width:1200px;margin:0 auto;padding:80px clamp(20px,5vw,56px) 64px;box-sizing:border-box;display:flex;flex-direction:column;gap:18px;align-items:flex-start">
	<h2 class="ds-display-lg" style="margin:0" data-reveal>This is a map, not a syllabus.</h2>
	<p style="margin:0;color:var(--ds-text-2);max-width:58ch;text-wrap:pretty" data-reveal>
		One engineer’s read on where the craft is going. If you’d draw it differently, argue with me — that’s Act III in practice.
	</p>
	<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:4px" data-reveal>
		<a class="ds-btn" href="mailto:contact@abhijitbansal.com?subject=The%20New%20Craft">Argue with me ↗</a>
		<a class="ds-btn-quiet" href={`${base}#work`}>See the work ↗</a>
		<a class="ds-btn-quiet" href={`${base}harness/`}>See the harness ↗</a>
	</div>
</section>
