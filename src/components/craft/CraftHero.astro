---
// CraftHero.astro — id craft-top. Kicker/h1/lead/CTAs, mirroring
// HarnessHero's rhythm (same top padding, radial accent glow, container)
// but deliberately quieter: no score card, no hero figure. Copy verbatim
// from the approved canvas (.scratch/craft-canvas/Main.dc.html).
const base = import.meta.env.BASE_URL;
---

<section id="craft-top" data-screen-label="Hero — the job after code" style="position:relative;padding:clamp(120px,12vw,160px) 0 clamp(56px,8vw,96px);scroll-margin-top:72px;overflow:hidden">
	<div aria-hidden="true" style="position:absolute;inset:0;z-index:0;background:radial-gradient(900px 420px at 22% 8%, color-mix(in srgb, var(--ds-accent) 8%, transparent), transparent 66%)"></div>
	<div style="position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);box-sizing:border-box;display:flex;flex-wrap:wrap;gap:32px 48px;align-items:flex-end;justify-content:space-between">
		<div style="max-width:640px;display:flex;flex-direction:column;gap:22px">
			<p class="ds-kicker" style="margin:0">Essay · the job after code</p>
			<h1 class="ds-display-xl" style="margin:0">Code is the <span style="color:var(--ds-accent)">smallest</span><br />part now.</h1>
			<p class="ds-lead" style="margin:0;max-width:56ch;text-wrap:pretty">
				The engineers who thrive next won’t be the fastest typists with the best autocomplete. They’ll be the ones who can run a
				team — theirs just happens to be made of agents. What firms have always looked for in people leaders is now an
				engineering skill.
			</p>
			<div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:6px">
				<a class="ds-btn-quiet" href="#craft-direct">I · Direct ↓</a>
				<a class="ds-btn-quiet" href="#craft-delegate">II · Delegate ↓</a>
				<a class="ds-btn-quiet" href="#craft-verify">III · Verify ↓</a>
			</div>
		</div>
		<div style="display:flex;flex-direction:column;gap:10px;border:1px solid var(--ds-line);border-radius:var(--ds-radius-md);padding:18px 20px;background:var(--ds-surface);min-width:230px;max-width:280px">
			<span class="ds-micro" style="color:var(--ds-text-3)">Field notes by</span>
			<span class="ds-heading" style="color:var(--ds-text)">Abhijit Bansal</span>
			<span class="ds-caption" style="color:var(--ds-text-3);max-width:26ch;text-wrap:pretty">
				Practiced daily on this site’s own harness — <a href={`${base}harness/`} style="color:var(--ds-accent-hover);text-decoration:none">audited at 79/100, gaps included →</a>
			</span>
		</div>
	</div>
</section>
