---
// HeroYard.astro — Sheet A-01. The yard is the hero: the isometric works
// drawn at build time, inside a drawing-sheet frame with the revision block
// and title block. Hosts two easter eggs (design_handoff_eggs/PROMPT.md):
//   Egg 2 — the working drawings overlay (type "plans", or hold #fy-pill 1.1s)
//   Egg 3 — the night whistle (press-and-hold the yard 0.9s)
// Layout reference: docs/plans/2026-10-06-drawing-set/A-Home.reference.html.
import WorksCity from './WorksCity.astro';
import statsJson from '../../data/stats.json';
import { loadWorksRepos } from '../lib/yard-data';
import { revisionRows } from '../lib/revisions';
import { getAllWeeksDesc } from '../lib/weekly';
import { formatSheetDate } from '../lib/sheet';
import { formatDateRange } from '../lib/telemetry';

const worksRepos = loadWorksRepos();
const revisions = revisionRows(getAllWeeksDesc(), 4);
const latestRev = revisions[0]?.rev ?? null;
const { meta } = statsJson;
const dateRange = formatDateRange(meta.date_min, meta.date_max);
const sheetDate = formatSheetDate(new Date());

const fmt = (n: number) => n.toLocaleString('en-US');
const revLabel = (r: (typeof revisions)[number]) =>
	`Revision ${r.rev}, ${r.week}: ${fmt(r.lines)} lines, ${fmt(r.sessions)} sessions` + (r.lead ? `, led by ${r.lead}` : '');

const RULER = ['A', 'B', 'C', 'D', 'E', 'F'];
const NOTES = [
	'Height is lines added. Eight storeys max.',
	'Lit windows are output tokens.',
	'Smoke means the repo was worked on this week.',
	'A crane means work in progress.',
	'Pennants are pull requests merged this week.',
	'Per-repo figures are floors; old transcripts rotate out.',
];

// Egg 2's survey-grid overlay — one crosshair per corner, same markup,
// only the position differs.
const DWG_CORNERS = [
	{ top: '10px', left: '10px' },
	{ top: '10px', right: '10px' },
	{ bottom: '10px', left: '10px' },
	{ bottom: '10px', right: '10px' },
];
---

<div style="max-width:1360px;margin:0 auto;padding:40px clamp(16px,3vw,40px) 0">
	<section id="top" data-screen-label="Hero — the yard" aria-labelledby="hero-h" class="fy-sheet-frame">
		<div aria-hidden="true" class="fy-ruler">
			{RULER.map((c) => <div>{c}</div>)}
		</div>

		<div class="fy-hero-row">
			<div class="fy-hero-main">
				<div class="fy-mono-label">Sheet A-01 — the yard</div>
				<h1 id="fy-callout-a" class="ds-display-xl fy-dwg-outline" style="margin:0;text-wrap:balance;max-width:15em;position:relative">
					<span id="hero-h">I build privacy-first apps, and the agent tooling I build them with.</span>
					<span class="fy-dwg-piece fy-dwg-badge" aria-hidden="true" style="top:-9px;left:-14px">A</span>
				</h1>
				<p id="fy-callout-c" class="ds-lead fy-dwg-outline" style="margin:0;max-width:34em;text-wrap:pretty;position:relative">
					Designed, engineered and shipped solo. Apps on the App Store, tools in the open, and the infrastructure underneath. Every building below is one of the repos, drawn from its own history.
					<span class="fy-dwg-piece fy-dwg-badge" aria-hidden="true" style="top:-9px;left:-14px">C</span>
				</p>
				<div id="fy-callout-d" class="fy-hero-actions fy-dwg-outline">
					<a class="ds-btn" href="#schedule">See the schedule ↓</a>
					<a href="https://github.com/abhijitbansal" target="_blank" rel="noopener">GitHub</a>
					<a href="mailto:contact@abhijitbansal.com">contact@abhijitbansal.com</a>
					<span class="fy-dwg-piece fy-dwg-badge" aria-hidden="true" style="top:-9px;left:-14px">D</span>
				</div>
			</div>

			{
				revisions.length > 0 && (
					<aside aria-labelledby="rev-h" class="fy-rev">
						<div class="fy-rev-head">
							<h2 id="rev-h" class="fy-block-h">Revisions</h2>
							<a href={`${import.meta.env.BASE_URL}updates/`} class="fy-mono-link">All weeks →</a>
						</div>
						<div class="fy-rev-table">
							<div aria-hidden="true" class="fy-rev-row fy-rev-cols">
								<span>Rev</span>
								<span>Week</span>
								<span style="text-align:right">Lines</span>
								<span style="text-align:right">Sess.</span>
								<span>Lead</span>
							</div>
							<ul role="list" style="margin:0;padding:0;list-style:none">
								{revisions.map((r) => (
									<li class="fy-rev-row fy-rev-item" aria-label={revLabel(r)}>
										<span class="fy-rev-mark" style={`color:${r.isLatest ? 'var(--ds-secondary)' : 'var(--ds-text-3)'}`}>
											<svg aria-hidden="true" width="13" height="12" viewBox="0 0 13 12">
												<path d="M6.5 1 L12 11 H1 Z" fill="none" stroke="currentColor" stroke-width="1.4" />
											</svg>
											{r.rev}
										</span>
										<span>{r.week}</span>
										<span style="text-align:right">{fmt(r.lines)}</span>
										<span style="text-align:right">{fmt(r.sessions)}</span>
										<span>{r.lead ?? '—'}</span>
									</li>
								))}
							</ul>
						</div>
					</aside>
				)
			}
		</div>

		<!-- Egg 3 — the night whistle (design_handoff_eggs/PROMPT.md): press-and-
		     hold the yard 0.9s to flip it to the night shift. The only way to
		     reach the night render — see fy-yard-night in drawing-set.css. The
		     figure needs no surface by day: the sheet frame is the border, and
		     .fy-yard-night paints it when night. -->
		<figure id="fy-yard-card" class="fy-yard-fig">
			<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap">
				<span id="fy-yard-title" class="fy-mono-label" style="color:var(--ds-text)">The works — one building per repo</span>
				<!-- The hover/whistle hints are SIBLINGS of #fy-yard-meta, not children:
				     the night egg does meta.textContent = … (applyState below), which
				     would destroy child elements. The wrapper keeps the header flex row
				     seeing one item. .fy-hover-hint hides on touch (no :hover highlight
				     exists in works-svg.ts) and both hint spans hide in night mode —
				     nightMeta carries its own whistle clause (rules in global.css). -->
				<span class="fy-mono-label" style="line-height:1.8"
					><span id="fy-yard-meta">All-time · {dateRange} · {worksRepos.length} repos</span
					><span class="fy-hover-hint"> · hover a building</span
					><span class="fy-yard-meta-tail"> · the shift ends at the whistle</span
				></span>
			</div>
			<div id="fy-yard-wrap" class="fy-hold-target" style="position:relative;touch-action:manipulation">
				<WorksCity variant="yard" repos={worksRepos} />
				<div id="fy-yard-hold-caption" aria-hidden="true" style="position:absolute;left:50%;bottom:12px;transform:translateX(-50%);width:min(300px,64%);display:none;flex-direction:column;gap:6px;align-items:center;pointer-events:none;z-index:3">
					<span id="fy-yard-hold-text" style="font:500 9px var(--ds-font-mono);letter-spacing:0.14em;color:var(--ds-text-2);white-space:nowrap">HOLDING — THE SHIFT ENDS AT THE WHISTLE</span>
					<span style="display:block;width:100%;height:2px;background:var(--ds-accent-soft);overflow:hidden;position:relative"
						><span id="fy-yard-hold-bar" style="position:absolute;inset:0;background:var(--ds-accent);transform-origin:left center"></span></span
					>
				</div>
				<div id="fy-yard-veil" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;border-radius:inherit;display:none"></div>
			</div>
		</figure>

		<div class="fy-notes-row">
			<div class="fy-notes">
				<div id="fy-yard-legend-day" style="display:flex;flex-direction:column;gap:10px">
					<h2 class="fy-block-h">Notes</h2>
					<ol class="fy-notes-list">
						{NOTES.map((n) => <li>{n}</li>)}
					</ol>
				</div>
				<p id="fy-yard-legend-night" class="ds-caption" style="display:none;margin:0;color:var(--ds-text-2)">
					The fire kept in: every gold window was paid for in tokens. A distant two-tone whistle called the shift; hold again and a single toot brings the dawn.
				</p>
			</div>
			<div class="fy-title-block">
				<div class="fy-tb-cell fy-tb-span2 fy-tb-bb fy-tb-br">
					<div class="fy-tb-label">Project</div>
					<div class="fy-tb-project">The Foundry</div>
				</div>
				<div class="fy-tb-cell fy-tb-bb">
					<div class="fy-tb-label">Sheet</div>
					<div class="fy-tb-sheet">A-01</div>
				</div>
				<div class="fy-tb-cell fy-tb-br">
					<div class="fy-tb-label">Drawn</div>
					A. Bansal
				</div>
				<div class="fy-tb-cell fy-tb-br">
					<div class="fy-tb-label">Period</div>
					{dateRange}
				</div>
				<div class="fy-tb-cell">
					<div class="fy-tb-label">Rev</div>
					{latestRev ? <span style="color:var(--ds-secondary);font-weight:600">{latestRev}</span> : <span>—</span>}
				</div>
				<div class="fy-tb-cell fy-tb-span3 fy-tb-bt">
					<div class="fy-tb-label">Date</div>
					<span
						id="fy-pill"
						class="fy-hold-target"
						title="the drawings are kept close at hand"
						style="position:relative;cursor:default;display:inline-block"
						>{sheetDate}<span
							id="fy-pill-hold"
							aria-hidden="true"
							style="position:absolute;left:10%;right:10%;bottom:-7px;height:2px;background:var(--ds-accent-soft);overflow:hidden;display:none"
							><span id="fy-pill-hold-bar" style="position:absolute;inset:0;background:var(--ds-text);transform-origin:left center"></span></span
						><span id="fy-callout-b" class="fy-dwg-piece fy-dwg-badge" aria-hidden="true" style="top:-8px;left:-8px">B</span></span
					>
				</div>
			</div>
		</div>

		<!-- Egg 2 — the working drawings overlay (design_handoff_eggs/PROMPT.md).
		     Toggled by typing "plans" anywhere (site-wide, BaseLayout.astro) or
		     holding the date stamp; every piece is inert until .fy-dwg-open is
		     set on this section (see the <script> at the bottom of this file). -->
		<div
			aria-hidden="true"
			class="fy-dwg-piece"
			style="position:absolute;inset:0;z-index:4;pointer-events:none;background-image:repeating-linear-gradient(0deg, color-mix(in srgb, var(--ds-secondary) 7%, transparent) 0 1px, transparent 1px 24px),repeating-linear-gradient(90deg, color-mix(in srgb, var(--ds-secondary) 7%, transparent) 0 1px, transparent 1px 24px)"
		>
			{
				DWG_CORNERS.map((pos) => (
					<svg
						width="18"
						height="18"
						viewBox="0 0 18 18"
						style={`position:absolute;${Object.entries(pos)
							.map(([k, v]) => `${k}:${v}`)
							.join(';')}`}
					>
						<line x1="9" y1="0" x2="9" y2="18" stroke="var(--ds-secondary)" stroke-width="1" />
						<line x1="0" y1="9" x2="18" y2="9" stroke="var(--ds-secondary)" stroke-width="1" />
						<circle cx="9" cy="9" r="5" fill="none" stroke="var(--ds-secondary)" stroke-width="0.8" />
					</svg>
				))
			}
			<span style="position:absolute;right:38px;top:8px;font:500 8.5px var(--ds-font-mono);letter-spacing:0.14em;color:var(--ds-accent-hover)">SHEET 1 OF 1 · NOT FOR CONSTRUCTION</span>
		</div>

		<div
			id="fy-dwg-title-block"
			class="fy-dwg-piece"
			style="position:absolute;right:16px;bottom:14px;z-index:5;pointer-events:none;border:1px solid var(--ds-line-strong);background:color-mix(in srgb, var(--ds-surface) 94%, transparent);border-radius:var(--ds-radius-sm);padding:10px 13px;display:flex;flex-direction:column;gap:5px;max-width:270px"
		>
			<span style="font:600 9.5px var(--ds-font-mono);letter-spacing:0.14em;color:var(--ds-accent-hover)">FOUNDRY — WORKING DRAWINGS</span>
			<span style="font:500 8.5px var(--ds-font-mono);letter-spacing:0.1em;color:var(--ds-text-3)">DWG 04-B · REV C · SCALE 1:1 · DO NOT SCALE</span>
			<span style="font:500 8.5px var(--ds-font-mono);letter-spacing:0.06em;color:var(--ds-text-3);line-height:1.6"
				>A — h1 · Archivo 750, wdth 118<br />B — date stamp · build-time<br />C — lead · 34em, text-wrap: pretty<br />D — ink button + text link</span
			>
			<button type="button" id="fy-dwg-close" style="all:unset;cursor:pointer;font:600 8.5px var(--ds-font-mono);letter-spacing:0.14em;color:var(--ds-accent);margin-top:3px">✕ FILE THE DRAWINGS</button>
		</div>
	</section>
</div>

<style>
	.fy-sheet-frame {
		position: relative;
		border: var(--fy-sheet-rule) solid var(--ds-text);
		scroll-margin-top: 72px;
	}
	.fy-ruler {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		font: 400 11px var(--ds-font-mono);
		color: var(--ds-text-3);
		border-bottom: 1px solid var(--ds-line-strong);
	}
	.fy-ruler > div {
		padding: 3px 8px;
		border-right: 1px solid var(--ds-line);
	}
	.fy-ruler > div:last-child {
		border-right: 0;
	}
	.fy-hero-row {
		display: flex;
		flex-wrap: wrap;
		gap: 40px 56px;
		padding: clamp(24px, 4vw, 56px);
	}
	.fy-hero-main {
		flex: 999 1 600px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.fy-mono-label {
		font: 400 13.5px var(--ds-font-mono);
		letter-spacing: 0;
		color: var(--ds-text-3);
	}
	.fy-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px 28px;
		align-items: center;
		margin-top: 6px;
		position: relative;
		width: fit-content;
		padding-right: 2px;
	}
	.fy-hero-actions a:not(.ds-btn) {
		font-size: 16px;
		font-weight: 500;
	}
	.fy-rev {
		flex: 1 1 340px;
		min-width: 0;
		align-self: flex-end;
	}
	.fy-rev-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		border-bottom: 1.5px solid var(--ds-text);
		padding-bottom: 6px;
	}
	.fy-block-h {
		margin: 0;
		font-size: 15px;
		font-weight: 700;
		font-stretch: 112%;
	}
	.fy-mono-link {
		font: 400 12.5px var(--ds-font-mono);
	}
	.fy-rev-table {
		font: 400 12.5px var(--ds-font-mono);
		font-variant-numeric: tabular-nums;
	}
	.fy-rev-row {
		display: grid;
		grid-template-columns: 60px minmax(0, 1fr) 64px 48px 72px;
		gap: 8px;
		padding: 7px 0;
	}
	.fy-rev-cols {
		color: var(--ds-text-3);
	}
	.fy-rev-item {
		border-top: 1px solid var(--ds-line);
	}
	.fy-rev-mark {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.fy-yard-fig {
		margin: 0;
		border-top: 1px solid var(--ds-line-strong);
		padding: clamp(8px, 2vw, 24px);
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.fy-notes-row {
		display: flex;
		flex-wrap: wrap;
		border-top: var(--fy-sheet-rule) solid var(--ds-text);
	}
	.fy-notes {
		flex: 999 1 520px;
		min-width: 0;
		padding: 20px clamp(16px, 3vw, 32px);
	}
	.fy-notes-list {
		margin: 0;
		padding-left: 20px;
		columns: 2 220px;
		column-gap: 32px;
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--ds-text-2);
	}
	.fy-title-block {
		flex: 1 1 420px;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-left: var(--fy-sheet-rule) solid var(--ds-text);
		font-size: 13px;
	}
	.fy-tb-cell {
		padding: 10px 14px;
	}
	.fy-tb-span2 {
		grid-column: span 2;
	}
	.fy-tb-span3 {
		grid-column: span 3;
	}
	.fy-tb-bb {
		border-bottom: 1px solid var(--ds-line-strong);
	}
	.fy-tb-bt {
		border-top: 1px solid var(--ds-line-strong);
	}
	.fy-tb-br {
		border-right: 1px solid var(--ds-line-strong);
	}
	.fy-tb-label {
		font: 400 11px var(--ds-font-mono);
		color: var(--ds-text-3);
	}
	.fy-tb-project {
		font-weight: 800;
		font-stretch: 125%;
		font-size: 17px;
	}
	.fy-tb-sheet {
		font-weight: 700;
		font-size: 17px;
	}
	@media (max-width: 639px) {
		.fy-title-block {
			border-left: 0;
			border-top: 1px solid var(--ds-line-strong);
		}
	}

	/* Egg 2 */
	.fy-dwg-piece {
		opacity: 0;
		pointer-events: none;
		visibility: hidden;
		transition: opacity 0.45s var(--ds-ease-standard), visibility 0.45s;
	}
	.fy-dwg-badge {
		position: absolute;
		width: 17px;
		height: 17px;
		border-radius: 0;
		border: 1px solid var(--ds-accent);
		background: var(--ds-surface);
		color: var(--ds-accent);
		font: 600 9.5px/16px var(--ds-font-mono);
		text-align: center;
	}
	#top.fy-dwg-open .fy-dwg-piece {
		opacity: 1;
		visibility: visible;
	}
	#top.fy-dwg-open #fy-dwg-title-block {
		pointer-events: auto;
	}
	.fy-dwg-outline {
		outline: none;
	}
	#top.fy-dwg-open .fy-dwg-outline {
		outline: 1px dashed color-mix(in srgb, var(--ds-accent) 50%, transparent);
		outline-offset: 8px;
	}
	@media (prefers-reduced-motion: reduce) {
		.fy-dwg-piece {
			transition: none;
		}
	}
</style>

<script>
	import { closeDrawings, isDrawingsOpen, onDrawingsChange, reducedMotion, toggleDrawings, wireHold } from '../lib/eggs';

	const heroSection = document.getElementById('top');
	const pill = document.getElementById('fy-pill');
	const pillHold = document.getElementById('fy-pill-hold');
	const pillHoldBar = document.getElementById('fy-pill-hold-bar');
	const closeBtn = document.getElementById('fy-dwg-close');

	if (heroSection) {
		const titleBlock = document.getElementById('fy-dwg-title-block');
		const applyOpen = (open: boolean) => {
			heroSection.classList.toggle('fy-dwg-open', open);
			titleBlock?.toggleAttribute('inert', !open);
		};
		applyOpen(isDrawingsOpen());
		onDrawingsChange(applyOpen);
	}

	closeBtn?.addEventListener('click', () => closeDrawings());

	if (pill instanceof HTMLElement && pillHold instanceof HTMLElement && pillHoldBar instanceof HTMLElement) {
		wireHold(
			pill,
			1100,
			() => toggleDrawings(),
			(holding) => {
				pillHold.style.display = holding ? 'block' : 'none';
				pillHoldBar.style.animation = holding && !reducedMotion ? 'fy-hold 1.1s linear forwards' : 'none';
			},
		);
	}
</script>

<script>
	import { readFlag, reducedMotion, whistle, wireHold, writeFlag } from '../lib/eggs';

	const card = document.getElementById('fy-yard-card');
	const wrap = document.getElementById('fy-yard-wrap');
	const veil = document.getElementById('fy-yard-veil');
	const holdCaption = document.getElementById('fy-yard-hold-caption');
	const holdText = document.getElementById('fy-yard-hold-text');
	const holdBar = document.getElementById('fy-yard-hold-bar');
	const title = document.getElementById('fy-yard-title');
	const meta = document.getElementById('fy-yard-meta');
	const legendDay = document.getElementById('fy-yard-legend-day');
	const legendNight = document.getElementById('fy-yard-legend-night');

	if (card && wrap && veil && holdCaption && holdText && holdBar && title && meta && legendDay && legendNight) {
		const dayTitle = title.textContent ?? '';
		const dayMeta = meta.textContent ?? '';
		const nightTitle = 'The works — the night shift';
		const nightMeta = 'lit windows = tokens out · hold the yard — dawn comes at the whistle';

		let night = readFlag('fy-shift');

		function applyState() {
			title!.textContent = night ? nightTitle : dayTitle;
			meta!.textContent = night ? nightMeta : dayMeta;
			legendDay!.style.display = night ? 'none' : 'flex';
			legendNight!.style.display = night ? 'block' : 'none';
			holdText!.textContent = night ? 'HOLDING — THE DAY SHIFT CLOCKS IN' : 'HOLDING — THE SHIFT ENDS AT THE WHISTLE';
			card!.classList.toggle('fy-yard-night', night);
		}

		applyState();

		let flipTimer: ReturnType<typeof setTimeout> | null = null;
		let hideTimer: ReturnType<typeof setTimeout> | null = null;

		wireHold(
			wrap,
			900,
			() => {
				const toNight = !night;
				whistle(toNight);
				writeFlag('fy-shift', toNight);
				if (reducedMotion) {
					night = toNight;
					applyState();
					return;
				}
				if (flipTimer) clearTimeout(flipTimer);
				if (hideTimer) clearTimeout(hideTimer);
				veil.style.display = 'block';
				veil.style.background = 'linear-gradient(180deg,color-mix(in srgb, var(--fy-night-bg) 80%, black),var(--fy-night-bg) 70%)';
				// Reset before reassigning — an in-flight veil re-triggered by a
				// quick second hold would otherwise get the identical animation
				// string twice in a row, which the browser doesn't restart.
				veil.style.animation = 'none';
				void veil.offsetWidth;
				veil.style.animation = 'fy-veil 1.7s var(--ds-ease-standard) forwards';
				flipTimer = setTimeout(() => {
					flipTimer = null;
					night = toNight;
					applyState();
				}, 650);
				hideTimer = setTimeout(() => {
					hideTimer = null;
					veil.style.display = 'none';
					veil.style.animation = 'none';
				}, 1750);
			},
			(holding) => {
				holdCaption.style.display = holding ? 'flex' : 'none';
				holdBar.style.animation = holding && !reducedMotion ? 'fy-hold 0.9s linear forwards' : 'none';
			},
		);
	}
</script>
