---
// HarnessHero.astro — id harness-top. SheetHead (C-01) carrying the title,
// lead, CTAs and the "audited by its own machinery" score card in its aside,
// then the Hall SVG figure with its figcaption legend. The two internal
// anchors are prefixed harness-* per AGENTS.md decisions: #harness-routing
// (Walk the line CTA) and #harness-score (score card link). No top padding:
// the sticky in-flow nav already clears the page top.
import { buildHall } from '../../lib/harness-svg';
import SheetHead from '../SheetHead.astro';
---

<section id="harness-top" data-screen-label="Hero — machine hall" style="padding:0 0 clamp(64px,9vw,110px);scroll-margin-top:64px">
	<div style="max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,56px);box-sizing:border-box;display:flex;flex-direction:column;gap:36px">
		<SheetHead code="C-01" title="The harness that runs this foundry." lead="The model does the reasoning. Everything else — hooks, guards, routing rules, recorders — decides what it may do, how work gets dispatched, and what survives the session. Drawn below as the machine hall it behaves like.">
			<Fragment slot="actions">
				<a class="ds-btn" href="#harness-routing">Walk the line ↓</a>
				<a class="ds-btn-quiet" href="mailto:contact@abhijitbansal.com?subject=Harness%20feedback">Help me get better</a>
			</Fragment>
			<div slot="aside" style="display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--ds-line-strong);padding-top:12px">
				<span class="ds-micro" style="color:var(--ds-text-3)">Audited by its own machinery</span>
				<span style="font:500 40px/1 var(--ds-font-mono);font-variant-numeric:tabular-nums">79<span style="color:var(--ds-text-3);font-size:0.5em"> / 100</span> <span class="ds-micro" style="color:var(--ds-secondary)">↑ from 73</span></span>
				<span class="ds-caption" style="color:var(--ds-text-2);max-width:28ch">Independent adversarial re-score, not self-asserted. Honest gaps below — <a href="#harness-score">see what's still weak</a>.</span>
			</div>
		</SheetHead>
		<figure class="harness-figure" data-harness-figure="Hall" style="margin:0;border:1px solid var(--ds-line);border-radius:var(--ds-radius-lg);background:var(--ds-surface);padding:clamp(10px,2vw,22px);position:relative">
			<Fragment set:html={buildHall(true)} />
			<figcaption class="ds-caption" style="color:var(--ds-text-3);padding:12px 8px 2px;display:flex;gap:8px 22px;flex-wrap:wrap">
				<span><span style="color:var(--ds-accent-hover)">intake</span> the ask</span>
				<span><span style="color:var(--ds-accent-hover)">guards</span> deny the catastrophic</span>
				<span><span style="color:var(--ds-accent-hover)">routing</span> mode · tier · effort</span>
				<span><span style="color:var(--ds-accent-hover)">furnaces</span> fable/opus · sonnet · haiku</span>
				<span><span style="color:var(--ds-accent-hover)">casting</span> commits</span>
				<span><span style="color:var(--ds-accent-hover)">records</span> session logs</span>
				<span><span style="color:var(--ds-accent-hover)">return pipe</span> lessons become rules</span>
			</figcaption>
		</figure>
	</div>
</section>
