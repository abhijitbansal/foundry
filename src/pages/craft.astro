---
// craft.astro — "The New Craft": essay route on what the job is now that
// code is the smallest part — run your agents like a team. Shell mirrors
// harness.astro (BaseLayout + SkipLink + Nav + <main class="brand-skills">
// + Footer + initReveals) minus the fullscreen/tilt machinery this quiet
// page doesn't use. Copy and figures come from the approved design canvas
// via craft-content.ts / craft-svg.ts; brand: the editorial cyan lane
// (brand-skills), deliberately shared with /harness/.
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CraftHero from '../components/craft/CraftHero.astro';
import CraftAct from '../components/craft/CraftAct.astro';
import CraftFigure from '../components/craft/CraftFigure.astro';
import CraftCoda from '../components/craft/CraftCoda.astro';
import CraftFooterCTA from '../components/craft/CraftFooterCTA.astro';
import { buildCraftActs } from '../lib/craft-content';

const acts = buildCraftActs(`${import.meta.env.BASE_URL}harness/`);
---

<BaseLayout
	title="The New Craft — Abhijit Bansal — Foundry"
	description="Code is the smallest part of the job now. The skills that matter next are a manager's: direct, delegate, verify — your team just happens to be made of agents."
	canonicalPath="/craft/"
>
	<SkipLink href="#craft-top" label="Skip to the essay" />
	<Nav />
	<main class="brand-skills">
		<CraftHero />
		<CraftAct act={acts[0]} />
		<CraftAct act={acts[1]} />
		<CraftFigure />
		<CraftAct act={acts[2]} />
		<CraftCoda />
		<CraftFooterCTA />
	</main>
	<Footer />
	{/* Fullscreen overlay for the room figure — same machinery and markup as
	   harness.astro's #harness-fs-overlay (harness-fullscreen.ts is
	   figure-agnostic and keys off [data-harness-figure]). class="brand-skills"
	   is required: the overlay is a sibling of <main>, not a descendant, so
	   without it accent colors fall through to :root's Paperix red. */}
	<div id="harness-fs-overlay" class="brand-skills" hidden role="dialog" aria-modal="true" aria-label="Craft figure, fullscreen">
		<div class="harness-fs-bar">
			<div class="harness-fs-tabs" id="harness-fs-tabs"></div>
			<div class="harness-fs-rotate-hint" id="harness-fs-rotate-hint" role="status" aria-live="polite" hidden>
				<span class="harness-fs-rotate-hint-icon" aria-hidden="true">⟳</span>
				<span>Rotate for a better view</span>
				<button type="button" id="harness-fs-rotate-hint-dismiss" aria-label="Dismiss rotate hint">✕</button>
			</div>
			<div style="display:flex;align-items:center;gap:12px">
				<div class="harness-fs-zoom">
					<button type="button" id="harness-fs-zoom-out" aria-label="Zoom out">−</button>
					<span id="harness-fs-zoom-level">100%</span>
					<button type="button" id="harness-fs-zoom-in" aria-label="Zoom in">+</button>
				</div>
				<button type="button" class="harness-fs-close" id="harness-fs-close">Close ✕</button>
			</div>
		</div>
		<div class="harness-fs-stage" id="harness-fs-stage"></div>
	</div>
</BaseLayout>

<script>
	import { initReveals } from '../lib/reveal';
	import { initHarnessFullscreen } from '../lib/harness-fullscreen';

	initReveals();
	initHarnessFullscreen();
</script>
