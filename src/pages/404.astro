---
// 404.astro — plan Task 9.2, revised (design-pass C17). Minimal, token-styled
// page. No longer a redirect: it used to meta-refresh straight to the
// homepage, which made it unreachable and left Updates/Harness unreachable
// from it (its only exit was the homepage link). Now a real destination with
// the standard SkipLink/Nav/Footer shell, matching every other route.
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found — Abhijit Bansal — Foundry">
	<SkipLink href="#not-found" label="Skip to the message" />
	<Nav />
	<main id="not-found" class="brand-skills fy-404">
		<p class="ds-kicker fy-404-kicker">404</p>
		<h1 class="ds-display-lg" style="margin:0">Page not found</h1>
		<p class="ds-lead fy-404-lead">Nothing was forged at this address.</p>
		<p class="ds-lead fy-404-lead"><a href={import.meta.env.BASE_URL}>Go to the homepage &rarr;</a></p>
	</main>
	<Footer />
</BaseLayout>

<style>
	.fy-404 {
		/* Nav is fixed at 64px; box-sizing:border-box (no global default)
		   plus this padding keeps the h1 clear of the header and the
		   footer just below the fold, same as every other route. */
		min-height: calc(100vh - 64px);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.75rem;
		padding: calc(64px + 2rem) 2rem 2rem;
		background: var(--ds-bg);
		color: var(--ds-text);
	}

	.fy-404-kicker {
		/* Redundant with .ds-kicker's own --ds-accent-hover default
		   (foundation.css:167, the same 12px normal-text AA contrast fix) —
		   kept explicit rather than dropped so this doesn't silently regress
		   back to --ds-text-3 if .ds-kicker's default ever changes. */
		color: var(--ds-accent-hover);
	}

	.fy-404-lead {
		color: var(--ds-text-3);
		margin: 0;
	}

	.fy-404-lead a {
		color: var(--ds-accent-hover);
	}
</style>
