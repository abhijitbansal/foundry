---
// index.astro — plan Task 3.7. Assembles BaseLayout + all sections in 2A
// source order: SkipLink + Nav, then <main class="brand-skills"> wrapping
// HeroYard/Schedule/GeneralNotes/MeterReadings/HarnessPromo, then Footer.
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import Nav from '../components/Nav.astro';
import HeroYard from '../components/HeroYard.astro';
import Schedule from '../components/Schedule.astro';
import GeneralNotes from '../components/GeneralNotes.astro';
import MeterReadings from '../components/MeterReadings.astro';
import HarnessPromo from '../components/HarnessPromo.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
	<SkipLink />
	<Nav />
	<main class="brand-skills">
		<HeroYard />
		<Schedule />
		<GeneralNotes />
		<MeterReadings />
		<HarnessPromo />
	</main>
	<Footer />
</BaseLayout>

<script>
	import { initReveals } from '../lib/reveal';
	import { initTilt } from '../lib/tilt';

	initReveals();
	initTilt();
</script>
